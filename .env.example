# Senha compartilhada do time para o portão de acesso do deck.
#
# NEXT_PUBLIC_* vai no bundle do client — isto é uma barreira leve, não um
# segredo de verdade. Sem valor definido, o código cai no fallback "nuki2026".
#
# Copie este arquivo para .env.local no ambiente local, e defina a variável no
# projeto da Vercel antes do primeiro deploy.
NEXT_PUBLIC_DECK_PASSWORD=
