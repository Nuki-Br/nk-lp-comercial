# =============================================================================
# Nuki Propostas — variáveis de ambiente
#
# Copie para .env.local no ambiente local, e defina cada uma no projeto da
# Vercel antes do deploy.
#
# A divisão abaixo NÃO é convenção de nome. É uma fronteira de segurança:
# tudo que começa com NEXT_PUBLIC_ é embutido no bundle que vai pro browser.
# =============================================================================


# -----------------------------------------------------------------------------
# PÚBLICO — vai inline no bundle do cliente. Nunca coloque um segredo aqui.
# -----------------------------------------------------------------------------

# Senha compartilhada do deck de pitch rápido em /fast.
# É uma barreira pra manter o deck fora da web aberta, não um segredo de
# verdade: o gate é client-side, então o HTML do deck inteiro está no payload de
# quem baixar a página. Isso é conhecido e aceito — /fast precisa funcionar
# com o Supabase fora do ar. Ver docs/decisions.md ADR 9.
#
# ÚNICA variável do projeto com fallback: sem valor, o código cai em "nuki2026"
# e a app sobe assim, em silêncio.
NEXT_PUBLIC_DECK_PASSWORD=


# -----------------------------------------------------------------------------
# SERVIDOR — nunca prefixe com NEXT_PUBLIC_. Fazer isso é incidente de
# segurança, não bug. Nenhuma destas tem fallback: faltando, a app quebra
# no carregamento do módulo, de propósito.
# -----------------------------------------------------------------------------

# Supabase. O design de auth roda inteiro em server actions e proxy.ts, então
# a publishable key nunca chega ao browser e NÃO existe variante NEXT_PUBLIC_.
# Se algum dia um client component precisar de um browser client, adicionar as
# variantes prefixadas significa reauditar TODA policy de RLS naquele momento,
# porque aí a chave passa a ser realmente pública.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Chaves públicas de verificação do JWT. O `getClaims()` do proxy.ts verifica a
# assinatura do token localmente, sem chamada de rede; com chaves assimétricas é
# daqui que ele tira a chave pública. Não é segredo — é a metade pública de um
# par — mas fica sem prefixo NEXT_PUBLIC_ porque nada no browser precisa dela.
SUPABASE_JWKS_URL=

# Bypassa RLS. É a chave que lê a proposta do cliente depois da verificação do
# cookie. Se vazar pro bundle, o CI quebra — ver docs/testing.md.
SUPABASE_SECRET_KEY=

# Assina o cookie de acesso à proposta (HMAC-SHA256). 32+ bytes aleatórios:
#   openssl rand -base64 32
# Rotacionar invalida todos os links já enviados. Pra rotacionar sem derrubar
# ninguém: mova o valor antigo pra _PREVIOUS, publique o novo, espere o maxAge
# vencer, remova o _PREVIOUS.
PROPOSAL_COOKIE_SECRET=
PROPOSAL_COOKIE_SECRET_PREVIOUS=

# Chave do hash diário de visitante. O IP nunca vira coluna nem linha de log —
# só entra nesta função. A rotação por dia UTC é o que torna visitas de dias
# diferentes não-correlacionáveis.
#   openssl rand -base64 32
TRACKING_IP_SALT=


# -----------------------------------------------------------------------------
# MIGRATIONS — local apenas. NÃO adicione na Vercel; nada em runtime usa.
# -----------------------------------------------------------------------------

# Conexão direta, pro supabase CLI (db push / db lint / gen types).
# ATENÇÃO: a connection string precisa estar percent-encoded. Senhas geradas
# pelo Supabase costumam conter @ : / ? # — um db push falhando com erro de
# parse opaco é quase sempre isso.
DIRECT_URL=

# Pooled. NADA no repositório usa esta variável hoje.
#
# A intenção era `scripts/db-smoke.mjs` ler o catálogo por aqui. Não dá: o Node
# não traz driver de Postgres e `pg` seria dependência de runtime (Regra 3). O
# script fala com a Data API por `fetch`, sem dependência nenhuma — e responde
# uma pergunta melhor, que é QUEM alcança cada tabela, não se ela existe.
#
# Mantida porque a Vercel/Supabase a fornecem e porque a etapa 3 pode querer.
# Se ninguém usar até lá, apague.
DATABASE_URL=


# -----------------------------------------------------------------------------
# Deploys de preview na Vercel HERDAM as variáveis de produção por padrão.
# Sem escopo separado, uma URL de preview cria e serve propostas reais contra
# o banco de produção, e o tráfego dela entra nos números de um cliente real.
#
# No mínimo: PROPOSAL_COOKIE_SECRET diferente em Preview.
# Melhor: apontar Preview pra uma branch do Supabase.
# -----------------------------------------------------------------------------
