{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:next)",
      "Bash(npm run build)",
      "Bash(npm run test:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsx:*)",
      "Bash(npx @biomejs/biome check:*)",
      "Bash(npx @biomejs/biome ci:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(cut:*)",
      "Bash(node scripts/check-docs.mjs)",
      "Bash(node scripts/db-smoke.mjs)",
      "Bash(node scripts/prepare-inspetor-demo.mjs)",
      "Bash(supabase --version)",
      "Bash(supabase db lint:*)",
      "Bash(supabase gen types:*)",
      "Bash(supabase migration new:*)",
      "Bash(psql --version)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sI http://localhost:*)"
    ],
    "deny": [
      "Read(./public/demos/**)",
      "Read(./src/HTML/**)",
      "Read(./package-lock.json)"
    ]
  }
}
